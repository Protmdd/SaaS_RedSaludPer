# Variables de entorno raíz, consumidas por docker-compose.
# Copie este archivo como .env y complete los valores antes de levantar los servicios.

# Clave para firmar JWT. En producción usar una clave aleatoria larga (ej: openssl rand -hex 32).
SECRET_KEY=cambiar-en-produccion-clave-secreta-larga-y-aleatoria

# Credenciales de Supabase. Si se dejan vacías, el backend arranca en modo demostración
# con datos sintéticos en memoria (útil para evaluación sin Supabase configurado).
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
