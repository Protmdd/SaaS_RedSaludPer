# Credenciales de Supabase. Si se dejan vacías, la API arranca en modo demostración
# con datos sintéticos en memoria.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Clave para firmar JWT. En producción usar una clave aleatoria larga.
SECRET_KEY=cambiar-en-produccion-clave-secreta-larga-y-aleatoria

# Entorno
ENVIRONMENT=development

# Orígenes permitidos para CORS (frontend Next.js)
CORS_ORIGINS=["http://localhost:3000"]

# Redis (opcional, para caché distribuido)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
